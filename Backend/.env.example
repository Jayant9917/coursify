NODE_ENV=development
LOG_LEVEL=info
MONGODB_URL=mongodb://127.0.0.1:27017/coursify?replicaSet=rs0
TEST_MONGODB_URL=mongodb://127.0.0.1:27017/coursify_test?replicaSet=rs0
JWT_ACCESS_SECRET="replace-with-a-long-secret"
JWT_REFRESH_SECRET="replace-with-a-long-secret"
PORT=3002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-coursify-bucket
# Use s3 in production. Use local for development when S3 is unavailable.
MEDIA_STORAGE_PROVIDER=s3
LOCAL_MEDIA_ROOT=./uploads/media
LOCAL_UPLOAD_MAX_MB=200
LOCAL_UPLOAD_CHUNK_MB=8
S3_MULTIPART_PART_MB=8
S3_PRESIGN_EXPIRES_SECONDS=900
S3_MULTIPART_SESSION_TTL_HOURS=24
FRONTEND_URL=http://localhost:5173
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_NO_REPLY=Skillnest <no-reply@skillnest.com>
EMAIL_FROM_SECURITY=Skillnest Security <security@skillnest.com>
EMAIL_FROM_NOTIFICATIONS=Skillnest <notifications@skillnest.com>
EMAIL_REPLY_TO=support@skillnest.com
EMAIL_LOGO_URL=
COUPON_RESERVATION_TTL_MINUTES=30
YOUTUBE_API_KEY=your_youtube_api_key
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_PRODUCT_ID=your_product_id
LEMONSQUEEZY_VARIANT_ID=your_variant_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_AMOUNT_TOLERANCE_MINOR=100
LEMONSQUEEZY_CHECKOUT_TTL_MINUTES=5
COUPON_CLEANUP_INTERVAL_MS=60000
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=30
METRICS_ENABLED=true
METRICS_TOKEN=
QUEUE_ENABLED=false
